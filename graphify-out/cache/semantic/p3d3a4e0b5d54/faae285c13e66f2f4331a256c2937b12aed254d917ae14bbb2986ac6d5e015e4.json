{"nodes": [{"id": "readme_lifegram", "label": "Lifegram PWA", "file_type": "document", "source_file": "README.md", "source_location": "L1", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "readme_academia_area", "label": "Academia / Exercicios area (/academia)", "file_type": "concept", "source_file": "README.md", "source_location": "L15", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "readme_coragem_area", "label": "Coragem area - escada do medo (/coragem)", "file_type": "concept", "source_file": "README.md", "source_location": "L65", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "readme_desempenho_area", "label": "Desempenho area (/desempenho)", "file_type": "concept", "source_file": "README.md", "source_location": "L54", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Area without history says there is nothing to measure instead of showing zeros, since zero looks like a bad result when it is really absence of data."}, {"id": "readme_skills_registry", "label": "Areas registry (src/lib/skills.ts)", "file_type": "rationale", "source_file": "README.md", "source_location": "L56", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Creating a new area is adding one entry to the list; hub and Desempenho pick it up automatically."}, {"id": "readme_contextual_bottom_bar", "label": "Contextual bottom navigation bar", "file_type": "concept", "source_file": "README.md", "source_location": "L58", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "readme_rest_timer", "label": "Rest timer (90s default, fullscreen ring)", "file_type": "concept", "source_file": "README.md", "source_location": "L18", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "readme_absolute_anchored_timer", "label": "Timer anchored to absolute instant", "file_type": "rationale", "source_file": "README.md", "source_location": "L242", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Recomputes end minus now every frame instead of decrementing a counter, so rest stays correct with locked screen, background app or frozen tab timers."}, {"id": "readme_local_first_indexeddb", "label": "IndexedDB as source of truth (local-first)", "file_type": "rationale", "source_file": "README.md", "source_location": "L247", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Every write goes to an outbox queue and Supabase is updated later; no screen waits on the network, so no signal in the gym basement is a normal state, and a paused free-tier Supabase project does not break the app."}, {"id": "readme_outbox_sync_queue", "label": "Outbox sync queue (push/pull by updated_at)", "file_type": "concept", "source_file": "README.md", "source_location": "L248", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "readme_supabase_cloud_sync", "label": "Supabase cloud sync (free, optional, magic link)", "file_type": "concept", "source_file": "README.md", "source_location": "L188", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "readme_supabase_schema", "label": "supabase/schema.sql and migrations", "file_type": "document", "source_file": "README.md", "source_location": "L191", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "readme_double_progression", "label": "Double progression (load-up suggestion at rep ceiling)", "file_type": "concept", "source_file": "README.md", "source_location": "L24", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Hitting rep ceiling (default 12) on all sets suggests load + increment (default 1 kg)."}, {"id": "readme_epley_1rm", "label": "Estimated 1RM (Epley formula)", "file_type": "concept", "source_file": "README.md", "source_location": "L162", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Lets 60kg x10 be compared with 70kg x6; comparison with last time is won by higher 1RM so trading load for reps counts as progress."}, {"id": "readme_monthly_progress_regression", "label": "Monthly progress via linear regression of 1RM (R2 consistency)", "file_type": "concept", "source_file": "README.md", "source_location": "L163", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "readme_stats_lib", "label": "Stats layer (src/lib/stats.ts, tested)", "file_type": "code", "source_file": "README.md", "source_location": "L171", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Pure logic with no React and no DB so it can be covered by tests."}, {"id": "readme_weekly_schedule_streak", "label": "Weekly schedule and streak rules", "file_type": "concept", "source_file": "README.md", "source_location": "L139", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Commitment is per day, not per workout; rest day always wins; bonus training never punishes; today only counts after it ends so streak never breaks mid-day."}, {"id": "readme_timed_compound_exercises", "label": "Timed and compound (block) exercises", "file_type": "concept", "source_file": "README.md", "source_location": "L124", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Timed sets excluded from kg volume and not mixed with rep sets in records - 40s and 12 reps are different quantities."}, {"id": "readme_two_stage_attempt", "label": "Two-stage attempt (predicted vs real score)", "file_type": "rationale", "source_file": "README.md", "source_location": "L71", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Prediction recalled after the result is contaminated by it, so prediction is saved before facing the situation."}, {"id": "readme_score_never_drops_alone", "label": "Fear score never drops automatically (reassessment suggestion)", "file_type": "rationale", "source_file": "README.md", "source_location": "L77", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "readme_statistical_honesty", "label": "Statistical honesty thresholds (src/lib/courage.ts)", "file_type": "rationale", "source_file": "README.md", "source_location": "L89", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Under 3 attempts no conclusion; 3-4 'data suggests'; 5+ trend; pattern analysis only from 15 complete attempts."}, {"id": "readme_trail_map", "label": "Trail map - 500 levels in 20 chapters (src/lib/trackCarisma.ts)", "file_type": "concept", "source_file": "README.md", "source_location": "L96", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Content lives in code and only progress goes to the DB, so new levels are appended at chapter end, never in the middle."}, {"id": "readme_adaptive_trail", "label": "Adaptive trail (Facil/Normal/Dificil, src/lib/tracks.ts)", "file_type": "concept", "source_file": "README.md", "source_location": "L108", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "readme_trail_calibration", "label": "Trail calibration - 14 questions (src/lib/trackCalibration.ts)", "file_type": "concept", "source_file": "README.md", "source_location": "L112", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "readme_self_esteem_levels", "label": "40 self-esteem levels (2 per chapter)", "file_type": "concept", "source_file": "README.md", "source_location": "L115", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "readme_coragem_painel", "label": "Coragem dashboard with CSV/JSON export (/corage